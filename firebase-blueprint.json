{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account and print shop information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name or shop contact" },
        "shopName": { "type": "string", "description": "Print shop business name" },
        "printTypes": { "type": "string", "description": "Primary print technology used" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "printJobs": {
      "title": "Print Job History",
      "description": "Saved pre-flight audits, generated cards, cost estimates and doctor reports",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "description": "Unique job identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "jobTitle": { "type": "string", "description": "Title or description of the print job" },
        "toolType": { "type": "string", "description": "AI tool used for processing" },
        "status": { "type": "string", "enum": ["Ready", "Warning", "Action Required", "Completed"] },
        "summary": { "type": "string", "description": "Brief result summary" },
        "createdAt": { "type": "string", "description": "Job timestamp" }
      },
      "required": ["jobId", "userId", "jobTitle", "toolType", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "Individual user document"
    },
    "/printJobs/{jobId}": {
      "schema": { "$ref": "#/entities/printJobs" },
      "description": "Individual print job record"
    }
  }
}
